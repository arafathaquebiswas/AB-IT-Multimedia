<?xml version="1.0" encoding="utf-8"?>
<!--
    D. Audio in landscape: artwork on the left and the controls on the right, so Play/Pause, Stop
    and the seek bar fit on screen without scrolling. Same view IDs as layout/fragment_audio.xml,
    so AudioFragment works with both.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".audio.AudioFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_m">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width_wide">

                <FrameLayout
                    android:id="@+id/audio_artwork"
                    android:layout_width="@dimen/audio_artwork_size_compact"
                    android:layout_height="@dimen/audio_artwork_size_compact"
                    android:background="@drawable/bg_audio_artwork"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="@dimen/audio_artwork_icon_size_compact"
                        android:layout_height="@dimen/audio_artwork_icon_size_compact"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_music_note"
                        app:tint="?attr/colorOnPrimaryContainer" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_l"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/audio_artwork"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/track_title_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/audio_track_title"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/audio_track_artist"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <SeekBar
                        android:id="@+id/audio_seek_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:contentDescription="@string/audio_seek_content_description"
                        android:minHeight="@dimen/touch_target_min" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_m"
                        android:paddingEnd="@dimen/space_m">

                        <TextView
                            android:id="@+id/elapsed_time_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            tools:text="01:12" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/total_time_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            tools:text="03:25" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/stop_button"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="@dimen/audio_stop_button_size"
                            android:layout_height="@dimen/audio_stop_button_size"
                            android:contentDescription="@string/audio_stop"
                            android:insetTop="@dimen/button_inset_none"
                            android:insetBottom="@dimen/button_inset_none"
                            app:icon="@drawable/ic_stop"
                            app:iconGravity="textStart"
                            app:iconSize="@dimen/audio_stop_icon_size" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/play_pause_button"
                            style="@style/Widget.Material3.Button.IconButton.Filled"
                            android:layout_width="@dimen/audio_play_button_size"
                            android:layout_height="@dimen/audio_play_button_size"
                            android:layout_marginStart="@dimen/space_l"
                            android:contentDescription="@string/audio_play"
                            android:insetTop="@dimen/button_inset_none"
                            android:insetBottom="@dimen/button_inset_none"
                            app:icon="@drawable/ic_play"
                            app:iconGravity="textStart"
                            app:iconSize="@dimen/audio_play_icon_size" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/audio_error_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:gravity="center"
                        android:text="@string/audio_error"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorError"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:gravity="center"
                        android:text="@string/audio_credit"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_footer_watermark" />
</LinearLayout>
