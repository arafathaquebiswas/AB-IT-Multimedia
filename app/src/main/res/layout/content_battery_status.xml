<?xml version="1.0" encoding="utf-8"?>
<!-- Activity 2, battery option: live data from the ACTION_BATTERY_CHANGED system broadcast -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/battery_heading"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/battery_description"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.ABITMultimedia.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/battery_percent_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceDisplayMedium"
                android:textColor="?attr/colorPrimary"
                tools:text="76%" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/battery_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:contentDescription="@string/battery_level_content_description"
                android:max="100"
                app:trackCornerRadius="@dimen/battery_progress_corner_radius"
                app:trackThickness="@dimen/battery_progress_thickness"
                tools:progress="76" />

            <TextView
                android:id="@+id/charging_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Status: Charging" />

            <TextView
                android:id="@+id/battery_updated_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/battery_waiting"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/next_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/next"
        app:icon="@drawable/ic_arrow_forward"
        app:iconGravity="textEnd" />
</LinearLayout>
